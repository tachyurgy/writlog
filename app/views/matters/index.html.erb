<% content_for :title, "Matters" %>
<section class="hero">
  <h1>Commercial collections, one append-only log per matter.</h1>
  <p class="lede">Every matter below is a projection of its event log: demand, filing, service, default, judgment, enforcement, payments. Deadlines are computed from New York rules and rolled past weekends and court holidays. Documents are generated by background jobs and cannot be produced twice for the same inputs.</p>
  <p><%= link_to "Open a new matter", new_matter_path, class: "btn" %> <%= link_to "How it works", how_it_works_path, class: "btn ghost" %></p>
</section>

<div class="stat-row">
  <% Workflow::STATES.each do |s| %>
    <% next unless @state_counts[s] %>
    <div class="stat"><span class="stat-n"><%= @state_counts[s] %></span><%= state_badge(s) %></div>
  <% end %>
</div>

<div class="table-wrap">
<table class="grid">
  <thead><tr><th>Matter</th><th>Debtor</th><th>Client</th><th>State</th><th class="num">Balance</th><th>Next deadline</th></tr></thead>
  <tbody>
  <% @matters.each do |m| %>
    <tr>
      <td class="mono"><%= link_to m.reference, matter_path(m) %></td>
      <td><%= m.debtor_name %><% if m.guarantor_name %><br><small>Guarantor: <%= m.guarantor_name %></small><% end %></td>
      <td><%= m.client_name %></td>
      <td><%= state_badge(m.state) %></td>
      <td class="num mono"><%= money(m.balance_cents) %></td>
      <td>
        <% if m.next_deadline_on %>
          <strong><%= day(m.next_deadline_on) %></strong> <small class="<%= 'overdue' if m.next_deadline_on < Date.current %>"><%= days_until(m.next_deadline_on) %></small><br><small><%= m.next_deadline_label %></small>
        <% else %><small>none</small><% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
